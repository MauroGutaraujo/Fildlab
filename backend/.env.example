# Copia este archivo a `.env` y completa los valores reales. `.env` está en .gitignore: nunca lo subas.

# Cadena de conexión de Neon (rama principal/producción).
DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require

# pytest NO lee este archivo. Exporta DATABASE_URL_TEST explícitamente en la shell.
# Sólo una instancia PostgreSQL local desechable, base test_* o *_test, sin query.
# Cada sesión crea y elimina exclusivamente su esquema aleatorio test_<uuid>.
# Ejemplo: DATABASE_URL_TEST=postgresql://test:test@127.0.0.1:55439/fildlab_test

# Secreto de firma de JWT. Obligatorio, minimo 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de vigencia del access token (opcional, default 60).
JWT_EXPIRE_MIN=60

# Lista JSON de orígenes exactos; añadir previews/dominios propios explícitamente.
CORS_ORIGINS=["https://fildlab.pages.dev","https://fildlab-pwa.pages.dev","http://localhost:5173","http://localhost:5174"]
MAX_REQUEST_BODY_BYTES=2097152
REQUEST_BODY_TIMEOUT_SECONDS=15
# Ventana móvil por IP y global, POR PROCESO. Varias réplicas requieren límite
# adicional en proxy/edge. No confiar X-Forwarded-For de clientes arbitrarios;
# configurar el servidor para confiar sólo en la IP del proxy de despliegue.
LOGIN_ATTEMPTS_PER_WINDOW=10
LOGIN_GLOBAL_ATTEMPTS_PER_WINDOW=60
LOGIN_WINDOW_SECONDS=60
PASSWORD_VERIFY_CONCURRENCY=2
# Exportar también en el entorno del batch. Vigencia operativa, no confianza del modelo.
RUL_VIGENCIA_HORAS=48
# Exportar en API y batch; no se lee .env para estas políticas operativas.
RUL_DURACION_MAX_SEGUNDOS=600
RUL_LATIDO_SEGUNDOS=15
RUL_SILENCIO_SEGUNDOS=90
RUL_GRACIA_CRON_HORAS=2
# Por defecto usa modelos/activo.json. Para otro modelo, exportar AMBAS variables
# en el entorno del batch, con SHA256 revisado. No hay fallback a entrenar.
# RUL_MODELO_PATH=/ruta/absoluta/modelo.json
# RUL_MODELO_SHA256=<64 caracteres hexadecimales>

# Datos del primer usuario Gerencia, para `python -m app.scripts.crear_gerente`.
GERENTE_NOMBRE=
GERENTE_EMAIL=
GERENTE_PASSWORD=
